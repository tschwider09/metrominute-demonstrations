# Required
DATABASE_URL=mysql+pymysql://DB_USER:DB_PASS@DB_HOST/DB_NAME?charset=utf8mb4

# Optional
MTA_API_KEY=
MTA_FEED_PATHS=nyct%2Fgtfs,nyct%2Fgtfs-ace,nyct%2Fgtfs-bdfm,nyct%2Fgtfs-g,nyct%2Fgtfs-jz,nyct%2Fgtfs-l,nyct%2Fgtfs-nqrw,nyct%2Fgtfs-si
MTA_FEED_BASE_URLS=https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds,https://api.mta.info/Dataservice/mtagtfsfeeds
MTA_TIMEOUT_SECONDS=8
MTA_CACHE_SECONDS=20
MTA_MAX_AGE_SECONDS=240

# Hosted planner web UI (optional)
MMRT_STATION_GRAPH_PATH=/absolute/path/to/station_details.json
MMRT_GTFS_DIRS=/absolute/path/to/gtfs_static
MMRT_MATRIX_PATH=/absolute/path/to/non_weighted_planning_graph_matrix.json
MMRT_WEB_PORT=8080
MMRT_WEB_DEBUG=1
